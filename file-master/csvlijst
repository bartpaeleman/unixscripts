#!/usr/bin/env bash
# === Directory to CSV Generator ===

set -euo pipefail

# Default values
SHOW_ALL=true
SHOW_NAAM=false
SHOW_TYPE=false
SHOW_SIZE=false
SHOW_PATH=false
FILTER_HIDDEN=false
MUZIEK_DATABASE=false
UITVOER_BESTAND="output.csv"
BRONMAP="$(pwd)"

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "${1:-}" in
        -n) SHOW_NAAM=true; SHOW_ALL=false ;;
        -t) SHOW_TYPE=true; SHOW_ALL=false ;;
        -s) SHOW_SIZE=true; SHOW_ALL=false ;;
        -p) SHOW_PATH=true; SHOW_ALL=false ;;
        -f) FILTER_HIDDEN=true ;;
        -m) MUZIEK_DATABASE=true; SHOW_ALL=false ;;
        -o)
            if [[ -n "${2:-}" ]]; then
                UITVOER_BESTAND="$2"
                shift
            else
                echo "❌ -o requires a filename/location"
                exit 1
            fi
            ;;
        -d)
            if [[ -n "${2:-}" ]]; then
                BRONMAP="$2"
                shift
            else
                echo "❌ -d requires a directory"
                exit 1
            fi
            ;;
        -h|--help)
            echo "Usage: $0 [options]"
            echo "Options:"
            echo "  -n    Show FILE NAME"
            echo "  -t    Show FILE TYPE"
            echo "  -s    Show FILE SIZE"
            echo "  -p    Show PATH"
            echo "  -f    Filter out hidden files"
            echo "  -m    Music database mode (ARTIST, TITLE, SIZE, FOLDER...)"
            echo "  -o    Output file (default: output.csv)"
            echo "  -d    Source folder (default: current folder)"
            exit 0
            ;;
        *)
            echo "❌ Unknown option: ${1:-}"
            exit 1
            ;;
    esac
    shift
done

# --- Path corrections ---
# Handle situations where -p is appended to a string or backslashes occur
if [[ ! -d "$BRONMAP" ]]; then
    if [[ "$BRONMAP" == *-p ]]; then
        test_map="${BRONMAP%-p}"
        test_map_clean="${test_map//\\ / }"
        if [[ -d "$test_map_clean" ]]; then
            BRONMAP="$test_map_clean"
            SHOW_PATH=true
            SHOW_ALL=false
        elif [[ -d "$test_map" ]]; then
            BRONMAP="$test_map"
            SHOW_PATH=true
            SHOW_ALL=false
        fi
    fi

    if [[ ! -d "$BRONMAP" ]]; then
        test_map_clean="${BRONMAP//\\ / }"
        if [[ -d "$test_map_clean" ]]; then
            BRONMAP="$test_map_clean"
        fi
    fi
fi

# Remove trailing slash to prevent directory depth issues later on
BRONMAP="${BRONMAP%/}"

if $SHOW_ALL; then
    SHOW_NAAM=true
    SHOW_TYPE=true
    SHOW_SIZE=true
    SHOW_PATH=true
fi

if [[ ! -d "$BRONMAP" ]]; then
    echo "❌ Source folder does not exist: $BRONMAP"
    exit 1
fi

# Temporary file for find results
TMP_FILE=$(mktemp -t lijst_csv.XXXXXX)
trap 'rm -f "$TMP_FILE"' EXIT INT TERM

# Find files
if $FILTER_HIDDEN; then
    find "$BRONMAP" -type f ! -name ".*" ! -path "*/.*" | sort > "$TMP_FILE"
else
    find "$BRONMAP" -type f | sort > "$TMP_FILE"
fi

# Function to convert array to csv row
to_csv() {
    local first=true
    for item in "$@"; do
        # Escape quotes and wrap with quotes
        item=$(echo "$item" | sed 's/"/""/g')
        if $first; then
            printf '"%s"' "$item"
            first=false
        else
            printf ',"%s"' "$item"
        fi
    done
    printf '\n'
}

{
    if $MUZIEK_DATABASE; then
        # Calculate maximum directory depth for dynamic columns
        max_depth=0
        while IFS= read -r f; do
            [[ -z "$f" ]] && continue
            dir_part="$(dirname "${f#$BRONMAP/}")"
            if [[ "$dir_part" != "." && -n "$dir_part" ]]; then
                depth=$(awk -F"/" '{print NF}' <<< "$dir_part")
                if [[ $depth -gt $max_depth ]]; then
                    max_depth=$depth
                fi
            fi
        done < "$TMP_FILE"

        HEADER=("ARTIST" "TITLE" "SIZE")
        for ((i=1; i<=max_depth; i++)); do
            HEADER+=("FOLDER $i")
        done
        to_csv "${HEADER[@]}"

        while IFS= read -r bestand; do
            [[ -z "$bestand" ]] && continue

            ROW=()
            bestandsnaam=$(basename "$bestand")
            base_naam="${bestandsnaam%.*}"

            if [[ "$base_naam" == *" - "* ]]; then
                artiest="${base_naam%% - *}"
                titel="${base_naam#* - }"
            else
                artiest="Unknown"
                titel="$base_naam"
            fi

            # Determine size
            if stat --version 2>/dev/null | grep -q 'GNU'; then
                grootte=$(stat -c %s "$bestand")
            else
                grootte=$(stat -f %z "$bestand")
            fi

            ROW+=("$artiest" "$titel" "$grootte")

            dir_part="$(dirname "${bestand#$BRONMAP/}")"
            maps=()
            if [[ "$dir_part" != "." && -n "$dir_part" ]]; then
                IFS='/' read -ra maps <<< "$dir_part"
            fi

            # Fill up to max_depth
            for ((i=0; i<max_depth; i++)); do
                if [[ $i -lt ${#maps[@]} ]]; then
                    ROW+=("${maps[$i]}")
                else
                    ROW+=("")
                fi
            done

            to_csv "${ROW[@]}"
        done < "$TMP_FILE"
    else
        # Build the header
        HEADER=()
        $SHOW_NAAM && HEADER+=("FILE NAME")
        $SHOW_TYPE && HEADER+=("FILE TYPE")
        $SHOW_SIZE && HEADER+=("FILE SIZE")
        $SHOW_PATH && HEADER+=("PATH")

        to_csv "${HEADER[@]}"

        while IFS= read -r bestand; do
            [[ -z "$bestand" ]] && continue

            ROW=()

            bestandsnaam=$(basename "$bestand")

            # Determine type (extension)
            if [[ "$bestandsnaam" == *.* ]] && [[ "$bestandsnaam" != .* || "$bestandsnaam" == *.*.* ]]; then
                type="${bestandsnaam##*.}"
            else
                type=""
            fi

            # Size (macOS and Linux compatible)
            if stat --version 2>/dev/null | grep -q 'GNU'; then
                grootte=$(stat -c %s "$bestand")
            else
                grootte=$(stat -f %z "$bestand")
            fi

            $SHOW_NAAM && ROW+=("$bestandsnaam")
            $SHOW_TYPE && ROW+=("$type")
            $SHOW_SIZE && ROW+=("$grootte")
            $SHOW_PATH && ROW+=("$bestand")

            to_csv "${ROW[@]}"
        done < "$TMP_FILE"
    fi
} > "$UITVOER_BESTAND"

echo "✅ CSV file created: $UITVOER_BESTAND"
