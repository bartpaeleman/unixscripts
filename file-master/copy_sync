#!/bin/bash

# Zorg dat autocomplete het scherm niet overvol maakt door het te wissen bij tab
set -o emacs
bind '"\t": "\C-l\e\e"' 2>/dev/null || true

# ============================================================
# COPY & SYNC TOOL
# Sync or copy files/folders via rsync
# ============================================================

set -u

# Colors
GREEN='\033[1;32m'
CYAN='\033[1;36m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m'

show_help() {
    echo -e "${CYAN}=== Copy & Sync Tool ===${NC}"
    echo "Usage: $0 [options]"
    echo ""
    echo "An interactive script to copy or sync files and folders"
    echo "using rsync."
    echo ""
    echo "Options:"
    echo "  -h, --help    Show this help message"
    echo ""
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    show_help
    exit 0
fi

echo -e "${CYAN}================================================${NC}"
echo -e "              ${CYAN}COPY & SYNC TOOL${NC}"
echo -e "${CYAN}================================================${NC}"

# Ask for the source folder
echo -e "${YELLOW}Provide the source folder (use Tab for autocomplete):${NC}"
read -e -p "Source: " source_dir

# Correct spacing/escapes as per memory
source_dir="${source_dir//\\ / }"
# Remove trailing slash to be safe with rsync, we'll append it later if needed
source_dir="${source_dir%/}"

if [ ! -d "$source_dir" ]; then
    echo -e "${RED}Error: Source folder '$source_dir' does not exist.${NC}"
    exit 1
fi

# Ask for the target folder
echo -e "\n${YELLOW}Provide the target folder (use Tab for autocomplete):${NC}"
read -e -p "Target: " target_dir

target_dir="${target_dir//\\ / }"
target_dir="${target_dir%/}"

if [ -z "$target_dir" ]; then
    echo -e "${RED}Error: Target cannot be empty.${NC}"
    exit 1
fi

if [ ! -d "$target_dir" ]; then
    echo -e "${YELLOW}Target folder does not exist yet. Creating...${NC}"
    mkdir -p "$target_dir"
fi

# Choose action
echo -e "\n${CYAN}Choose an action:${NC}"
echo "1) Copy (Transfer new or changed files, don't delete anything on target)"
echo "2) Sync 1-way (Only add new files, don't delete, don't overwrite existing)"
echo "3) Sync exact (Make target exactly like source, including DELETING on target)"
echo "X) Cancel"

read -e -p "Choice: " choice

# Array for safe processing of arguments
rsync_flags=("-avh" "--progress")

case "$choice" in
    1)
        echo -e "\n${GREEN}Mode: Copy${NC}"
        ;;
    2)
        echo -e "\n${YELLOW}Mode: Sync 1-way (--ignore-existing will be added)${NC}"
        rsync_flags+=("--ignore-existing")
        ;;
    3)
        echo -e "\n${RED}Mode: Sync exact (--delete will be added)${NC}"
        rsync_flags+=("--delete")
        ;;
    [Xx])
        echo -e "${YELLOW}Cancelled.${NC}"
        exit 0
        ;;
    *)
        echo -e "${RED}Invalid choice. Cancelled.${NC}"
        exit 1
        ;;
esac

# Filters
echo -e "\n${CYAN}--- Set Filters ---${NC}"

# Exclude hidden files
read -e -p "Exclude hidden files (e.g. .DS_Store, .git)? (y/n) [n]: " exclude_hidden
if [[ "$exclude_hidden" == "y" || "$exclude_hidden" == "Y" ]]; then
    rsync_flags+=("--exclude=.*" "--exclude=*/.*")
fi

# Exclude extensions
read -e -p "Exclude specific extensions? (e.g. mp4, tmp, log or leave empty): " exclude_exts
if [[ -n "$exclude_exts" ]]; then
    # Replace commas with spaces and iterate
    for ext in ${exclude_exts//,/ }; do
        # Remove leading dot
        ext="${ext#.}"
        rsync_flags+=("--exclude=*.$ext")
    done
fi

# Exclude specific names
read -e -p "Exclude specific folders or files? (e.g. node_modules, build or leave empty): " exclude_names
if [[ -n "$exclude_names" ]]; then
    for name in ${exclude_names//,/ }; do
        rsync_flags+=("--exclude=$name")
    done
fi

# Construct rsync command
# Notice we append '/' to source to copy contents into target_dir
echo -e "\n${YELLOW}Executing: rsync ${rsync_flags[*]} \"$source_dir/\" \"$target_dir/\"${NC}"
echo -e "Press Enter to start or Ctrl+C to cancel..."
read -r

rsync "${rsync_flags[@]}" "$source_dir/" "$target_dir/"

echo -e "\n${GREEN}✅ Action completed!${NC}"
